{
  "name": "feltmath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5199 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "verify:blackjack": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=/tmp/feltmath-verify-blackjack.mjs && node /tmp/feltmath-verify-blackjack.mjs",
    "verify:holdem": "esbuild scripts/verify-holdem.ts --bundle --platform=node --format=esm --outfile=/tmp/feltmath-verify-holdem.mjs && node /tmp/feltmath-verify-holdem.mjs",
    "verify:klondike": "esbuild scripts/verify-klondike.ts --bundle --platform=node --format=esm --outfile=/tmp/feltmath-verify-klondike.mjs && node /tmp/feltmath-verify-klondike.mjs",
    "verify:deployment": "esbuild scripts/verify-deployment.ts --bundle --platform=node --format=esm --outfile=/tmp/feltmath-verify-deployment.mjs && node /tmp/feltmath-verify-deployment.mjs",
    "test": "npm run verify:blackjack && npm run verify:holdem && npm run verify:klondike && npm run verify:deployment"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
